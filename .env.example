# Copia este archivo a ".env" y ajusta los valores para tu entorno.
# NUNCA subas el archivo ".env" real a un repositorio.

# --- Entorno ---
FLASK_ENV=development

# --- Sesiones de Flask (cookies de las páginas HTML) ---
# Genera un valor aleatorio, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-larga

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=inamhi_app
DB_PASSWORD=cambia-esta-contrasena
DB_NAME=inamhi_inventario

# --- API JSON con JWT (Flask-JWT-Extended) ---
# Debe ser DISTINTO de SECRET_KEY.
JWT_SECRET_KEY=cambia-esta-otra-clave-distinta-a-secret-key

# --- CORS (solo aplica al prefijo /api/) ---
# Usa "*" en desarrollo, o el dominio exacto del frontend en producción (ej. https://app.inamhi.gob.ec)
CORS_ORIGINS=*

# --- Respaldos automáticos (mysqldump) ---
BACKUP_DIR=respaldos
# En Windows, si mysqldump no está en el PATH, indica la ruta completa, por ejemplo:
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
MYSQLDUMP_PATH=mysqldump
